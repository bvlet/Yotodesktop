{
  "name": "desktop-for-yoto",
  "version": "0.3.2",
  "description": "Drag-and-drop audio onto Yoto MYO cards.",
  "author": "Bart <bvlet@ziggo.nl>",
  "main": "dist/main.js",
  "private": true,
  "engines": {
    "node": "24.20.x"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "ffmpeg-static": "^5.3.0",
    "lucide": "^1.38.0",
    "pdf-lib": "^1.17.1",
    "yoto-nodejs-client": "^0.0.11"
  },
  "build": {
    "appId": "co.samuelmillett.desktop-for-yoto",
    "productName": "Desktop for Yoto",
    "icon": "src/images/app_icon.png",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/@huggingface/**"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models"
      }
    ],
    "files": [
      "dist/**",
      "package.json",
      "node_modules/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "bvlet",
      "repo": "Yotodesktop"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "ffmpeg-static@5.3.0": true,
    "onnxruntime-node@1.24.3": true,
    "sharp@0.34.5": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}
